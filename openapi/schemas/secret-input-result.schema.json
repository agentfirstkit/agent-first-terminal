{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/secret-input-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "description": "Who opened the window, absent when it is not open",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "human",
                "agent",
                "renderer",
                "controller",
                "test",
                "replay"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "description": "Operator context for the window; never what is being typed",
      "maxLength": 256,
      "type": [
        "string",
        "null"
      ]
    },
    "secret_input": {
      "type": "boolean"
    },
    "session_id": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "secret_input",
    "actor",
    "reason"
  ],
  "title": "SecretInputResult",
  "type": "object"
}
