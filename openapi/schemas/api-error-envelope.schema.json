{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/api-error-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "hint": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "kind": {
      "const": "error"
    },
    "trace": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "duration_ms"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "error",
    "trace"
  ],
  "title": "ApiErrorEnvelope",
  "type": "object"
}
