{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/input-actor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "human",
        "agent",
        "renderer",
        "controller",
        "test",
        "replay"
      ],
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "title": "InputActor",
  "type": "object"
}
