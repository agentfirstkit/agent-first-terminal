{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/send-input-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "renderer",
            "controller",
            "test",
            "replay"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "data_base64": {
      "contentEncoding": "base64",
      "description": "Raw bytes to write to the PTY",
      "type": "string"
    },
    "lease_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "actor",
    "data_base64"
  ],
  "title": "SendInputRequest",
  "type": "object"
}
