{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/open-session-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "args": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cols": {
      "default": 80,
      "maximum": 1000,
      "minimum": 2,
      "type": "integer"
    },
    "cwd_path": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "program": {
      "description": "Program to execute; null or omitted resolves to the server user's shell",
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "rows": {
      "default": 24,
      "maximum": 1000,
      "minimum": 2,
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "title": "OpenSessionRequest",
  "type": "object"
}
