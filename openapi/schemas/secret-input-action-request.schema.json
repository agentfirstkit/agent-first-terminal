{
  "$id": "https://agentfirstkit.com/schemas/afterminal/v1/secret-input-action-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "start"
        },
        "actor": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "human",
                "agent",
                "renderer",
                "controller",
                "test",
                "replay"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "actor",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "end"
        },
        "actor": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            "kind": {
              "enum": [
                "human",
                "agent",
                "renderer",
                "controller",
                "test",
                "replay"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      },
      "required": [
        "action",
        "actor"
      ],
      "type": "object"
    }
  ],
  "title": "SecretInputActionRequest"
}
